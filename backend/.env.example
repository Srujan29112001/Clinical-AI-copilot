# ── Clinical AI Copilot — backend configuration ──
# Leave everything blank to run in zero-key DEMO mode (deterministic reasoning).
#
# Pick ONE of the two styles below per agent, or set a single global default.
# Agent roles: TRIAGE, DIAGNOSTICIAN, REPORTER, CHAT  (others reuse the global)

# ─────────────── Option A: LOCAL GPU (no key needed) ───────────────
# Run Ollama (ollama serve) or vLLM and point the backend at it.
# CLINICAL_LLM_PROVIDER=ollama
# CLINICAL_LLM_BASE_URL=http://localhost:11434/v1
# CLINICAL_LLM_MODEL=llama3.1:8b

# ─────────────── Option B: HOSTED API PROVIDER ───────────────
# CLINICAL_LLM_PROVIDER=anthropic
# CLINICAL_LLM_API_KEY=sk-ant-...
# CLINICAL_LLM_MODEL=claude-3-5-sonnet-latest
#
# Other supported: openai | groq | deepseek | mistral | openrouter | gemini

# ─────────────── Per-agent override example (hybrid) ───────────────
# Heavy reasoning on the cloud, fast triage on your local GPU:
# CLINICAL_DIAGNOSTICIAN_PROVIDER=anthropic
# CLINICAL_DIAGNOSTICIAN_API_KEY=sk-ant-...
# CLINICAL_TRIAGE_PROVIDER=ollama
# CLINICAL_TRIAGE_BASE_URL=http://localhost:11434/v1

# CORS (comma-separated) — set to your frontend origin in production
CLINICAL_CORS_ORIGINS=*
