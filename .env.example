# Clinical AI Copilot - Environment Variables
# Copy this file to .env and fill in your values

# ===== ENCRYPTION & SECURITY =====
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-generate_key
JWT_SECRET_KEY=your-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== DATABASE CONFIGURATION =====
# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clinical_db
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=change-this-secure-password

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-secure-password
NEO4J_DATABASE=medical_knowledge

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-secure-password

# ===== VECTOR DATABASE =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== STREAMING =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_EEG_STREAM=eeg-stream
KAFKA_TOPIC_ALERTS=clinical-alerts

# ===== API CONFIGURATION =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
API_DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===== MODEL CONFIGURATION =====
MODEL_PATH=/models
MODEL_PRECISION=fp16  # fp32, fp16, int8
MODEL_DEVICE=cuda:0
ENABLE_MODEL_CACHING=true

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.9

# ===== MONITORING =====
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=change-this-admin-password

# ===== LOGGING =====
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=./logs
AUDIT_LOG_DIR=./logs/audit
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for HIPAA

# ===== STORAGE =====
DATA_DIR=./data
ENCRYPTED_DATA_DIR=/mnt/encrypted/clinical-data
MODEL_CACHE_DIR=./models/cache

# ===== RATE LIMITING =====
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===== EXTERNAL SERVICES =====
# Email for alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@clinicalai.com

# Slack for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===== FEATURE FLAGS =====
ENABLE_REAL_TIME_STREAMING=true
ENABLE_GRAPH_RAG=true
ENABLE_VECTOR_SEARCH=true
ENABLE_MULTIMODAL_FUSION=true

# ===== HIPAA COMPLIANCE =====
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true
REQUIRE_MFA=false
SESSION_TIMEOUT_MINUTES=30

# ===== DEVELOPMENT =====
DEV_MODE=false
DEBUG_SQL=false
ENABLE_PROFILING=false

# ===== BACKUP =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=90
BACKUP_DESTINATION=/backups

# ===== TESTING =====
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_db
USE_MOCK_MODELS=false
